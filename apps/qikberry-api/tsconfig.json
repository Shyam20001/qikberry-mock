{
  "compilerOptions": {
    "target": "ES2022",
    "module": "EsNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "noEmit": false,
    "verbatimModuleSyntax": true,
    "outDir": "dist",
    "rootDir": "./src",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src"
  ]
}